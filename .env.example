# Copy to .env and fill in. Generate secrets with: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SECRET=
PASSWORD_PEPPER=

# Where the browser reaches the frontend and the backend.
# Change both if the app is accessed through another host/IP than localhost.
FRONTEND_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8080

# Browsers accept Secure cookies on http://localhost. Set to false only when testing over plain http on another host.
COOKIE_SECURE=true

# Cloudflare Turnstile captcha, shown after repeated failed logins. These are Cloudflare's public test keys:
# the site key always shows the interactive "Verify you are human" checkbox, the secret accepts every token.
# For real checks create a free widget (https://developers.cloudflare.com/turnstile/get-started/)
# and add the hostname (e.g. localhost) to it.
TURNSTILE_SITE_KEY=3x00000000000000000000FF
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
