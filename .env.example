# Copy to .env and fill in. Generate secrets with: openssl rand -base64 48
POSTGRES_PASSWORD=
JWT_SECRET=
PASSWORD_PEPPER=

# Where the browser reaches the frontend and the backend.
# Change both if the app is accessed through another host/IP than localhost.
FRONTEND_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:8080

# Browsers accept Secure cookies on http://localhost. Set to false only when testing over plain http on another host.
COOKIE_SECURE=true
